{
  "name": "sar-maker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "mkdir -p public src/wasm && GOOS=js GOARCH=wasm go build -o public/sar.wasm ../wasm && rm -f src/wasm/wasm_exec.js && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" src/wasm/wasm_exec.js && chmod +w src/wasm/wasm_exec.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
